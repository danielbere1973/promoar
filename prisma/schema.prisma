// Ancla de identidad persistente del rubro (propuesta-modelo-preferencias-usuario.md v2,
// CPO Approval 13/8/2026). label/icon/categorySlugs siguen viviendo en RUBRO_CATALOG
// (lib/rubroCatalog.ts) — esta tabla NO es la fuente de verdad de composición/display
// todavía, solo el punto de integridad referencial para UserRubroPreference. id coincide
// exactamente con RubroId (ej. 'supermercados', 'combustible').
model HomeRubro {
  id        String   @id
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  rubroPreferences UserRubroPreference[]

  @@map("home_rubros")
}

// Preferencia de usuario por rubro de Home. Declarada e inferida son filas independientes
// para el mismo (userId, rubroId) — ver propuesta-modelo-preferencias-usuario.md v2 §3 para
// el caso completo declarada→inferida→supresión sin pérdida de información. El default no
// se persiste acá (regla global de Producto, vive en decisionEngineV2.ts). Disponibilidad
// diaria (capa 3 del modelo de 3 capas) no se persiste — responsabilidad del Decision Engine.
model UserRubroPreference {
  id      String @id @default(cuid())
  userId  String
  rubroId String

  source PreferenceSource
  status PreferenceStatus @default(ACTIVE)

  score Float? // null para DECLARED; intensidad para INFERRED (sin escritor todavía)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  suppressedAt DateTime?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rubro HomeRubro @relation(fields: [rubroId], references: [id], onDelete: Restrict)

  @@unique([userId, rubroId, source])
  @@index([userId, status])
  @@map("user_rubro_preferences")
}

enum PreferenceSource {
  DECLARED
  INFERRED
}

enum PreferenceStatus {
  ACTIVE
  SUPPRESSED
}

// BASELINE 14-15/8/2026: shopping_lists / shopping_list_items existen físicamente en
// PROD (residuo pre-Prisma, sin código de producto que las use — ver
// auditoria-drift-shopping-salesbackup-14-8-2026.md). @@ignore: Prisma las trackea a
// nivel de migración/drift-check para que migrate dev no las reporte como drift ni
// proponga DROP, pero no genera ningún método de Client sobre ellas. No exponen
// funcionalidad. No borrar de este schema sin decisión de producto explícita.
model shopping_lists {
  id        String   @id
  userId    String
  name      String   @default("Mi lista")
  createdAt DateTime @default(now())
  updatedAt DateTime

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items shopping_list_items[]

  @@index([userId])
  @@ignore
}

model shopping_list_items {
  id             String   @id
  shoppingListId String
  query          String
  productName    String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  list shopping_lists @relation(fields: [shoppingListId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([shoppingListId])
  @@ignore
}
